# Copy to .env (not committed). Values already set in the shell, or passed as options, take precedence.

# Token the iPhone app uses for /replies and /webhook
REPLY_TOKEN=CHANGE_ME

# Where to relay transcriptions from POST /webhook. Leave empty to turn the relay off.
RELAY_URL=
# Token issued by the relay destination, sent as "Authorization: Bearer <token>"
RELAY_TOKEN=
