# Copy to .env (not committed). Values already set in the shell take precedence.

# Receiver for transcriptions relayed by the reply server (its RELAY_URL / RELAY_TOKEN)
PEBBLE_RING_HOST=127.0.0.1
PEBBLE_RING_PORT=8766
PEBBLE_RING_TOKEN=CHANGE_ME

# Catchball
CATCHBALL_URL=http://127.0.0.1:47821
CATCHBALL_JOIN_KEY_FILE=~/Library/Application Support/session-mail/tokens/join.key
CATCHBALL_ROOM=voice
PEBBLE_RING_ID=pebble-ring
PEBBLE_RING_NAME=Pebble リング
SECRETARY_ID=main

# Reply server (where replies for the iPhone go)
REPLY_SERVER_URL=http://127.0.0.1:8765
REPLY_TOKEN=CHANGE_ME

# Spoken summary: anthropic, or openai for any OpenAI-compatible API (OpenAI, DeepSeek, local LLMs)
SUMMARY_PROVIDER=anthropic
SUMMARY_MODEL=claude-haiku-5-5
SUMMARY_API_KEY=
# Only for openai, e.g. https://api.deepseek.com (default https://api.openai.com/v1)
SUMMARY_BASE_URL=

# Text-to-speech (OpenAI-compatible /v1/audio/speech; the local AivisSpeech adapter)
TTS_URL=http://127.0.0.1:10102
TTS_VOICE=
