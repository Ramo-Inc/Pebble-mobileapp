# Copy to .env (not committed). Values already set in the shell, or passed as options, take precedence.

# Token the iPhone app uses for /replies and /webhook
REPLY_TOKEN=CHANGE_ME

# Where to relay transcriptions from POST /webhook. Leave empty to turn the relay off.
RELAY_URL=
# Token issued by the relay destination, sent as "Authorization: Bearer <token>"
RELAY_TOKEN=

# Voice replies: a webhook that carries the recording (Recording only / Both) is answered by Gemini Live.
# Leave the key empty to turn this off; transcriptions then go to RELAY_URL as before.
# GOOGLE_CLOUD_API_KEY is also read when GEMINI_API_KEY is empty.
GEMINI_API_KEY=
# Live API model id. Empty uses gemini-3.8-live.
GEMINI_LIVE_MODEL=
# Optional prebuilt voice name, e.g. Kore. Empty uses the model's default voice.
GEMINI_VOICE=
# Optional system prompt. Empty uses the built-in Japanese voice-assistant prompt.
GEMINI_SYSTEM_PROMPT=
# How many past exchanges Gemini sees. Forget them with: python3 reply_server.py clear-history
GEMINI_HISTORY_TURNS=20
